{
  "name": "open-job-search",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source AI job search: find roles early, find your way in, apply well. Works in your agent CLI (Claude Code, Codex, Antigravity, opencode) or a local web app.",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "ojs": "bun packages/cli/src/index.ts",
    "web": "bun packages/web/src/server.ts",
    "worker": "bun packages/worker/src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
