!.env.example

# User data never belongs in this repo. It lives in ~/.ojs (or $OJS_HOME).
# These patterns are a safety net in case someone points OJS_HOME inside the checkout.
.ojs/
ojs-data/
*.cv.pdf
*.sqlite
*.sqlite-*
*.db

# Local planning docs, not published
docs/plan/

# Safety net: CVs and documents dropped into the repo by mistake.
# Your documents belong in ~/.ojs/profile/inbox, not here.
*.pdf
*.docx
*.doc
*.odt
*.rtf
*.pages
!packages/*/test/fixtures/**
