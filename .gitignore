node_modules/
dist/
*.log
.DS_Store
.env
.env.*
!.env.example

# Your stuff: documents/ (what you put in) and data/ (what ojs builds).
# Never committed, apart from the READMEs that explain them.
/documents/*
!/documents/README.md
!/documents/writing-samples/
/documents/writing-samples/*
!/documents/writing-samples/README.md
/data/*
!/data/README.md

# Local planning docs, not published
docs/plan/

# Safety net: CVs and documents dropped anywhere else in the repo by mistake.
*.pdf
*.docx
*.doc
*.odt
*.rtf
*.pages
!packages/*/test/fixtures/**
